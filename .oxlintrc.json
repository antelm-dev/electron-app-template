{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true,
    "node": true
  },
  "overrides": [
    {
      "files": ["src/renderer/**/*.ts"],
      "env": { "browser": true }
    }
  ]
}
