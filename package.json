{
  "name": "electron-app-template",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight Electron starter with Vite, Rollup, typed IPC, and electron-builder.",
  "license": "MIT",
  "author": "Your Name",
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "generate:ipc": "electron-ipc-module generate --ipc-dir ./src/main/ipc --out-file ./src/preload/generated/ipc-bridge.ts --tsconfig ./tsconfig.main.json",
    "check:ipc": "electron-ipc-module check --ipc-dir ./src/main/ipc --out-file ./src/preload/generated/ipc-bridge.ts --tsconfig ./tsconfig.main.json",
    "typecheck": "pnpm run generate:ipc && tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "test": "vitest run",
    "build": "pnpm run typecheck && pnpm run test && vite build",
    "preview": "pnpm run build && electron .",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:linux": "pnpm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-ipc-module": "^1.1.0",
    "electron-renderer-protocol": "^0.1.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-electron-run": "^0.4.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.15.1"
}
